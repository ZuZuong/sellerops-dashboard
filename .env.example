# Supabase – Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
# Chỉ dùng publishable (anon) key ở client. KHÔNG BAO GIỜ đưa secret/service_role key vào đây.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Phiên đăng nhập: mặc định MỖI TAB một phiên riêng (vd. tab admin + tab seller song song).
# Đặt true để mọi tab dùng chung một phiên như mặc định của Supabase (mở tab mới không phải đăng nhập lại).
# VITE_AUTH_SHARED_SESSION=false
